# --- Database ---
# Provisioned by Vercel Marketplace (Neon Postgres) → set in `vercel env pull`
DATABASE_URL=postgres://user:password@localhost:5432/ielts_trainer

# --- Auth (Supabase) ---
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth providers are configured inside Supabase dashboard:
#   Authentication → Providers → Google / Facebook
# No client IDs needed here — Supabase handles the OAuth flow.

# --- AI Service (GPU VPS) ---
AI_SERVICE_URL=http://localhost:8000
# Shared HMAC token between Vercel and the GPU VPS
AI_SERVICE_TOKEN=replace-with-shared-secret

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Error tracking (Sentry) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Ads ---
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADMOB_APP_ID=
