# --- Database ---
# Provisioned by Vercel Marketplace (Neon Postgres) → set in `vercel env pull`
DATABASE_URL=postgres://user:password@localhost:5432/ielts_trainer

# --- Auth (Better Auth) ---
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- AI Service (GPU VPS) ---
AI_SERVICE_URL=http://localhost:8000
# Shared HMAC token between Vercel and the GPU VPS
AI_SERVICE_TOKEN=replace-with-shared-secret

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Error tracking (Sentry) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Ads ---
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADMOB_APP_ID=
